# Local development only. Copy to .env and replace the password before starting.
POSTGRES_DB=job_management
POSTGRES_USER=job_management
POSTGRES_PASSWORD=replace-with-a-local-password

# FastAPI on the host: localhost and the port published by Compose.
# FastAPI in the same Compose network: override host=postgres and port=5432.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
