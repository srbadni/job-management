# Copy to .env at the repository root. Replace the local credentials before use.
APP_PORT=8000

# Compose uses the *_PORT values for host ports. In-container ports stay fixed.
# Host-mode Python uses the hostnames and endpoint below.
POSTGRES_DB=job_management
POSTGRES_USER=job_management
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

RABBITMQ_USER=job_management
RABBITMQ_PASSWORD=replace-with-a-local-rabbitmq-password
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ACCESS_KEY=job_management
MINIO_SECRET_KEY=replace-with-a-local-minio-secret
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Update the endpoint too if you change MINIO_PORT and run Python on the host.
MINIO_ENDPOINT=http://localhost:9000
# Set MINIO_IMAGE to override the pinned MinIO-compatible development image.
